wks.col2.lname$="Magnetic Field"; wks.col2.unit$="Oe";
wks.col3.lname$="Moment"; wks.col3.unit$="emu";
wks.col4.lname$="MT VSM cooling H=1000.1 Oe"; wks.col4.unit$="emu/g";
win -a MPMSData;
page.active=3;

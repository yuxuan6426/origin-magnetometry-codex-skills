// MPMS data import and MT/MH plots. Origin 2018+ design target.
[Main]
string mpmsRoot$;
dlgPath path:=mpmsRoot$ title:="Select the extracted MPMS data package folder";
if(mpmsRoot.GetLength()==0) { type "Folder selection cancelled."; break 1; }
run.section("%(mpmsRoot$)\import_and_plot.ogs", Import);

[Import]
type "Starting MPMS import...";
if(@V<9.5) { type "Origin 2018 or newer is required by this script. CSV files can be imported manually."; break 1; }
int mpmsPageCount=0;
doc -e P { mpmsPageCount++; }
if(mpmsPageCount>0) { type "Please open an empty Origin project, then run the script again."; break 1; }
string mpmsTarget$="%(mpmsRoot$)/origin_result.opju";
if(mpmsTarget.IsFile()) { type "origin_result.opju already exists. Choose a fresh package folder or rename the existing result."; break 1; }
newbook name:=MPMSData sheet:=27 option:=lsname;
win -a MPMSData;
page.active=1;
layer.name$="C001";
impASC fname:="%(mpmsRoot$)/csv/C001.csv" options.ImpMode:=0 options.Names.AutoNames:=0 options.Names.FNameToBk:=0 options.Names.FNameToSht:=0 options.Sparklines:=0;
layer.name$="C001";
if(wks.nCols!=4) { type "Import failed for C001. Check the selected package folder."; break 1; }
wks.col1.lname$="Temperature"; wks.col1.unit$="K";
wks.col2.lname$="Magnetic Field"; wks.col2.unit$="Oe";
wks.col3.lname$="Moment"; wks.col3.unit$="emu";
wks.col4.lname$="MT VSM warming H=1000.1 Oe"; wks.col4.unit$="emu/g";
win -a MPMSData;
page.active=2;
layer.name$="C002";
impASC fname:="%(mpmsRoot$)/csv/C002.csv" options.ImpMode:=0 options.Names.AutoNames:=0 options.Names.FNameToBk:=0 options.Names.FNameToSht:=0 options.Sparklines:=0;
